[Unit]
Description=Stone Sovereign CI validation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stone-ci
Group=stone-ci
WorkingDirectory=/var/lib/stone-ci
EnvironmentFile=-/etc/stone/sovereign-ci.env
ExecStart=/usr/local/lib/stone-ci/run-omniroute.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stone-ci
UMask=0077
